{
  "name": "reverb",
  "version": "1.4.0",
  "description": "An electron app for managing ADB commands",
  "main": "./out/main/index.js",
  "author": "Sknow",
  "homepage": "./",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --publish never",
    "verify-resources": "ls -la extraResources/",
    "build:mac": "npm run verify-resources && electron-vite build && electron-builder --mac --publish never",
    "build:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@uiw/react-codemirror": "^4.25.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-router-dom": "^2.1.0",
    "electron-updater": "^6.1.7",
    "lucide-react": "^0.456.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.0",
    "react-shiki": "^0.9.2",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/winston": "^2.4.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.5.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@radix-ui/*": "^1.0.0"
  },
  "build": {
    "appId": "com.sknow.reverb",
    "productName": "Reverb",
    "extraResources": [
      "./extraResources/**"
    ],
    "files": [
      "**/*",
      "!src/**",
      "!docs/**",
      "!scripts/**",
      "!extraResources/**",
      "!**/.*",
      "!**/.*/**",
      "!{tsconfig.json,tsconfig.node.json,tsconfig.web.json}",
      "!**/*.tsbuildinfo",
      "!{electron.vite.config.ts,eslint.config.mjs,postcss.config.js,tailwind.config.js}",
      "!components.json",
      "!package-lock.json",
      "!*.md",
      "!{sampleCommonCommands.json,sampleProject.json}",
      "!dev-app-update.yml"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "afterPack": "./scripts/after-pack.js",
    "win": {
      "executableName": "Reverb"
    },
    "nsis": {
      "artifactName": "${name}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always"
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Application requires access to the Documents folder.",
        "NSDownloadsFolderUsageDescription": "Application requires access to the Downloads folder."
      }
    },
    "dmg": {
      "artifactName": "${name}-${version}.${ext}"
    }
  }
}
